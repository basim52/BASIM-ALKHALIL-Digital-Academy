rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    // Global Settings - Explicitly public
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Curriculum
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users & Students
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      match /earlyChildhood/stickers {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isOwner(studentId) || isAdmin();
    }

    // Schedules & Notes
    match /schedules/{scheduleId} {
      allow read: if isSignedIn(); 
      allow write: if isSignedIn();
    }

    match /parentNotes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Progress & History
    match /user_progress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Chat & Conversations
    match /global_chat/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /conversations/{convId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /studyPlans/{planId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Credit System
    match /vouchers/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transactions/{transId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Legacy support or misc
    match /student_profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isOwner(profileId) || isAdmin();
    }
  }
}
