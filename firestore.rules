rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access unless explicitly granted below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && "email" in request.auth.token && (
          request.auth.token.email == "basim5252@gmail.com" ||
          request.auth.token.email.matches('(?i)^basim5252@gmail\\.com$')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Validates whether the current authenticated user is a linked parent of the student
    function isParentOf(studentId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/users/$(studentId)) && (
            (
              "linkedParentIds" in get(/databases/$(database)/documents/users/$(studentId)).data &&
              request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.linkedParentIds
            ) ||
            (
              "parentIds" in get(/databases/$(database)/documents/users/$(studentId)).data &&
              request.auth.uid in get(/databases/$(database)/documents/users/$(studentId)).data.parentIds
            )
          )
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          "linkedStudentIds" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentIds
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasNoForbiddenUserFields() {
      return !('credits' in request.resource.data) &&
             !('balance' in request.resource.data) &&
             !('points' in request.resource.data) &&
             !('xp' in request.resource.data) &&
             !('level' in request.resource.data) &&
             !('linkedStudentIds' in request.resource.data) &&
             !('linkedStudentId' in request.resource.data) &&
             !('linkedParentIds' in request.resource.data) &&
             !('parentIds' in request.resource.data);
    }

    // --- 1. Global Settings (settings/global explicitly public read) ---
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 2. Interactive Video Lessons (videos explicitly public read) ---
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 3. Curriculum & Educational Material ---
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 4. Users Collection (Protected Roles, Credits, Balance, Points & Link IDs) ---
    match /users/{userId} {
      // Read: Owner, linked parent, or admin ONLY (no blanket read for all signed-in users)
      allow get: if isOwner(userId) || isParentOf(userId) || isAdmin();
      // List: admin, or a linked parent querying ONLY their own children (query must filter parentIds/linkedParentIds
      // array-contains auth.uid; both fields are server-only, every returned doc must name the caller as parent).
      allow list: if isAdmin() || (isSignedIn() && (
        ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        ('linkedParentIds' in resource.data && resource.data.linkedParentIds is list && request.auth.uid in resource.data.linkedParentIds)
      ));

      // Create: Owner cannot self-assign admin role or set credit/balance/points/link fields. Only student/parent or no role.
      allow create: if isOwner(userId) && (
        isAdmin() || (
          hasNoForbiddenUserFields() &&
          (!('role' in request.resource.data) || (request.resource.data.role in ['student', 'parent'] && request.resource.data.role != 'admin'))
        )
      );

      // Update: User cannot change their role, credits, balance, points, xp, level, or linking fields. Only admin/server can change these.
      // Notice: We deliberately do NOT check hasNoForbiddenUserFields() here because if an admin previously granted
      // credits or balance, request.resource.data contains existing fields on the document, which would block normal profile edits.
      // Checking affectedKeys().hasAny(...) guarantees the user cannot modify, add, or delete protected fields.
      allow update: if (
        isAdmin() || (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'credits', 'balance', 'points', 'xp', 'level',
            'linkedStudentIds', 'linkedStudentId', 'linkedParentIds', 'parentIds'
          ])
        ) || (
          // Linked parent may set ONLY the child's weekly lesson goal (1..14)
          isSignedIn() &&
          (
            ('linkedParentIds' in resource.data && resource.data.linkedParentIds is list && request.auth.uid in resource.data.linkedParentIds) ||
            ('parentIds' in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds)
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weeklyGoalLessons']) &&
          request.resource.data.weeklyGoalLessons is int &&
          request.resource.data.weeklyGoalLessons >= 1 && request.resource.data.weeklyGoalLessons <= 14
        )
      );

      allow delete: if isAdmin();

      // Early childhood subcollection
      match /earlyChildhood/{document=**} {
        allow read: if isOwner(userId) || isParentOf(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Sara tutor chat state and archived sessions (users/{userId}/saraChat, saraSessions)
      match /saraChat/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /saraSessions/{sessionId} {
        allow read: if isOwner(userId) || isParentOf(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Sara smart-board sessions: real check-question counts only (no grades)
      match /saraBoardSessions/{sessionId} {
        allow read: if isOwner(userId) || isParentOf(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.keys().hasOnly(['personaId', 'topic', 'checksTotal', 'checksCorrect', 'createdAt']) &&
          request.resource.data.personaId in ['sara', 'grammar', 'business', 'exams'] &&
          request.resource.data.topic is string && request.resource.data.topic.size() <= 300 &&
          request.resource.data.checksTotal is int && request.resource.data.checksTotal >= 0 && request.resource.data.checksTotal <= 5 &&
          request.resource.data.checksCorrect is int && request.resource.data.checksCorrect >= 0 && request.resource.data.checksCorrect <= request.resource.data.checksTotal &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }

      // Earned Completion Certificates (users/{userId}/certificates/{unitId})
      // Sara end-of-level tests: student saves own attempts; parent/admin read; only admin edits/deletes
      match /saraLevelTests/{attemptId} {
        allow read: if isOwner(userId) || isParentOf(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
          request.resource.data.trackId is string && request.resource.data.levelId is string;
        allow update, delete: if isAdmin();
      }

      match /certificates/{unitId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.auth.uid == userId;
        allow update, delete: if isAdmin();
      }
    }

    // --- 5. Students Collection (Protected Economy & Gamification Fields) ---
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isParentOf(studentId) || isAdmin();

      // Create: Students and parents cannot initialize points, xp, level, credits, balance, or link IDs
      allow create: if isAdmin() || (
        (isOwner(studentId) || isParentOf(studentId)) &&
        !request.resource.data.keys().hasAny([
          'points', 'xp', 'level', 'credits', 'balance',
          'linkedStudentIds', 'linkedStudentId', 'linkedParentIds', 'parentIds'
        ])
      );

      // Update: Students and parents cannot change points, xp, level, credits, balance, or link IDs (only admin/server can)
      allow update: if isAdmin() || (
        (isOwner(studentId) || isParentOf(studentId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'points', 'xp', 'level', 'credits', 'balance',
          'linkedStudentIds', 'linkedStudentId', 'linkedParentIds', 'parentIds'
        ])
      );

      allow delete: if isAdmin();
    }

    // --- 6. Legacy / Misc Student Profiles (Protected Economy & Gamification Fields) ---
    match /student_profiles/{profileId} {
      allow read: if isOwner(profileId) || isParentOf(profileId) || isAdmin();

      // Create: Students and parents cannot initialize points, xp, level, credits, balance, or link IDs
      allow create: if isAdmin() || (
        (isOwner(profileId) || isParentOf(profileId)) &&
        !request.resource.data.keys().hasAny([
          'points', 'xp', 'level', 'credits', 'balance',
          'linkedStudentIds', 'linkedStudentId', 'linkedParentIds', 'parentIds'
        ])
      );

      // Update: Students and parents cannot change points, xp, level, credits, balance, or link IDs (only admin/server can)
      allow update: if isAdmin() || (
        (isOwner(profileId) || isParentOf(profileId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'points', 'xp', 'level', 'credits', 'balance',
          'linkedStudentIds', 'linkedStudentId', 'linkedParentIds', 'parentIds'
        ])
      );

      allow delete: if isAdmin();
    }

    // --- One-Time Parent Link Codes (Server-Admin Only, Deny All Client Read/Write) ---
    match /parentLinkCodes/{code} {
      allow read, write: if false;
    }

    // --- 7. Schedules & Timetables ---
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        isParentOf(request.resource.data.studentId) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId) ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
    }

    // --- 8. Parent Notes & Direct AI/Teacher Inquiries ---
    match /parentNotes/{noteId} {
      allow read: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.parentId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- 9. Homework Tasks & Assignments ---
    match /homework/{homeworkId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        isParentOf(request.resource.data.studentId) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- 10. AI Conversation Logs ---
    match /conversations/{convId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- 11. Vouchers System (Safe Individual Get & Atomic Redemption) ---
    match /vouchers/{code} {
      // Signed-in users can only 'get' a single code they typed. They CANNOT list all codes.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Redemption: safe transaction or update strictly requiring unused code,
      // moving to status: 'redeemed', recording redeemedBy: request.auth.uid
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'redeemed' &&
        request.resource.data.redeemedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'redeemedBy', 'redeemedAt'])
      );
    }

    // --- 12. Credit Transactions (Admin/Server write only, User reads own) ---
    match /transactions/{transId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- 13. Grades & Reports ---
    match /grades/{gradeId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isParentOf(resource.data.studentId) ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- 14. Progress Tracking ---
    match /user_progress/{progressId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- 15. Community Global Chat ---
    match /global_chat/{chatId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && !request.resource.data.text.lower().matches('.*(https?://|www[.]).*');
      allow update, delete: if isAdmin();
    }

    // --- 16. Study Plans & Lesson Results ---
    function isValidStudyPlan(data) {
      return data.userId is string && 
             (!('studentName' in data) || data.studentName is string) &&
             (!('planItems' in data) || data.planItems is list) &&
             (!('parentIds' in data) || data.parentIds is list);
    }

    function isValidLessonResult(data) {
      return data.userId is string && 
             data.lessonId is string && 
             (!('score' in data) || data.score is number) && 
             (!('total' in data) || data.total is number) &&
             (!('parentIds' in data) || data.parentIds is list);
    }

    match /studyPlans/{planId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ("parentIds" in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ("parentIds" in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isParentOf(request.resource.data.userId)
      ) && isValidStudyPlan(request.resource.data);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      ) && isValidStudyPlan(request.resource.data);
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
    }

    match /lessonResults/{resultId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ("parentIds" in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ("parentIds" in resource.data && resource.data.parentIds is list && request.auth.uid in resource.data.parentIds) ||
        isParentOf(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isParentOf(request.resource.data.userId)
      ) && isValidLessonResult(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // --- 17. System Notifications ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // --- 18. Daily Learning Streaks ---
    function isValidStreak(data) {
      return data.current is int && data.current >= 0 &&
             data.longest is int && data.longest >= 0 &&
             data.current <= data.longest + 1 &&
             data.freezesLeft is int && data.freezesLeft >= 0 && data.freezesLeft <= 1;
    }

    match /streaks/{uid} {
      allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isValidStreak(request.resource.data);
      allow delete: if false;
    }

    // --- 19. Sara AI English Tutor Memory & Sessions ---
    match /tutorMemory/{uid} {
      allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();

      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || isParentOf(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }
    // --- «فصل عبود المباشر» (additive; new collection only — nothing above changes) ---
    // The admin alone decides which registered students may join a host's class. The host (the student who opens
    // «عبود المعلّم») publishes the live lesson state; allowed students join, raise a hand, and may post ONLY while
    // the host has made them the current speaker of an active session. No XP/progress/certificate fields exist here.
    match /abboudClasses/{hostUid} {
      function abboudConfigPath() { return /databases/$(database)/documents/abboudClasses/$(hostUid); }
      function abboudLivePath() { return /databases/$(database)/documents/abboudClasses/$(hostUid)/live/state; }
      function isAbboudHost() { return isOwner(hostUid) && exists(abboudConfigPath()); }
      function isAbboudGuest() {
        return isSignedIn() && exists(abboudConfigPath()) && request.auth.uid in get(abboudConfigPath()).data.allowed;
      }
      function isValidAbboudConfig() {
        let d = request.resource.data;
        return d.keys().hasOnly(['hostUid', 'hostName', 'allowed', 'names', 'updatedAt']) &&
          d.hostUid == hostUid && isValidId(hostUid) &&
          d.hostName is string && d.hostName.size() <= 40 &&
          d.allowed is list && d.allowed.size() >= 1 && d.allowed.size() <= 30 && !(hostUid in d.allowed) &&
          d.names is map && d.names.size() <= 30 &&
          d.updatedAt == request.time;
      }

      allow get: if isAdmin() || isOwner(hostUid) || (isSignedIn() && request.auth.uid in resource.data.allowed);
      // Students list only classes that name them (query: allowed array-contains <own uid>).
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.allowed);
      allow create, update: if isAdmin() && isValidAbboudConfig();
      allow delete: if isAdmin();

      match /live/{docId} {
        allow read: if isAdmin() || isAbboudHost() || isAbboudGuest();
        allow create, update: if docId == 'state' && isAbboudHost() &&
          request.resource.data.keys().hasOnly(['active', 'sessionId', 'lessonId', 'lessonTitle', 'source', 'draft', 'explained', 'speaker', 'updatedAt']) &&
          request.resource.data.active is bool &&
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 40 &&
          request.resource.data.lessonId is int && request.resource.data.lessonId >= 1 && request.resource.data.lessonId <= 16 &&
          request.resource.data.lessonTitle is string && request.resource.data.lessonTitle.size() <= 80 &&
          request.resource.data.source is string && request.resource.data.source.size() <= 1200 &&
          request.resource.data.draft is string && request.resource.data.draft.size() <= 600 &&
          request.resource.data.explained is list && request.resource.data.explained.size() <= 40 &&
          request.resource.data.speaker is string &&
          (request.resource.data.speaker == '' || request.resource.data.speaker in get(abboudConfigPath()).data.allowed) &&
          request.resource.data.updatedAt == request.time;
        // live/feed: the shared clean transcript (Abboud's finished sentences + Badr/Reem/Sara replies), host only.
        allow create, update: if docId == 'feed' && isAbboudHost() &&
          request.resource.data.keys().hasOnly(['sessionId', 'items', 'updatedAt']) &&
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 40 &&
          request.resource.data.items is list && request.resource.data.items.size() <= 30 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isAbboudHost() || isAdmin();
      }

      // WebRTC signaling for live audio (host = hub). Only the host and that one listed guest can see their SDPs.
      match /rtc/{guestUid} {
        allow get: if isAdmin() || isAbboudHost() || (isOwner(guestUid) && isAbboudGuest());
        allow list: if isAdmin() || isAbboudHost();
        allow create, update: if isAbboudHost() && guestUid in get(abboudConfigPath()).data.allowed &&
          request.resource.data.keys().hasOnly(['sessionId', 'offer', 'answer', 'updatedAt']) &&
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 40 &&
          request.resource.data.offer is string && request.resource.data.offer.size() >= 1 && request.resource.data.offer.size() <= 16000 &&
          request.resource.data.answer == '' && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(guestUid) && isAbboudGuest() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'updatedAt']) &&
          request.resource.data.answer is string && request.resource.data.answer.size() <= 16000 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(guestUid) || isAbboudHost() || isAdmin();
      }

      match /participants/{uid} {
        allow read: if isAdmin() || isAbboudHost() || isAbboudGuest();
        // A student joins / heartbeats / raises or lowers their own hand.
        allow create, update: if isOwner(uid) && isAbboudGuest() &&
          request.resource.data.keys().hasOnly(['sessionId', 'hand', 'lastSeen']) &&
          request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 40 &&
          request.resource.data.hand is bool &&
          (request.resource.data.lastSeen == request.time || (resource != null && request.resource.data.lastSeen == resource.data.lastSeen));
        // The host may only lower a hand (decline a request).
        allow update: if isAbboudHost() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hand']) && request.resource.data.hand == false;
        allow delete: if isOwner(uid) || isAbboudHost() || isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isAdmin() || isAbboudHost() || isAbboudGuest();
        // Talking needs Abboud's permission: only the current speaker of the active session may post.
        allow create: if isAbboudGuest() && exists(abboudLivePath()) &&
          get(abboudLivePath()).data.active == true &&
          get(abboudLivePath()).data.speaker == request.auth.uid &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'via', 'sessionId', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300 &&
          request.resource.data.via in ['mic', 'text'] &&
          request.resource.data.sessionId == get(abboudLivePath()).data.sessionId &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAbboudHost() || isAdmin();
      }
    }
  }
}

