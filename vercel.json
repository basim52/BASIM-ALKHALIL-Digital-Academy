{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/ping",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|ping|src|node_modules|assets|@vite|@fs|@react-refresh).*)$",
      "destination": "/index.html"
    }
  ]
}
