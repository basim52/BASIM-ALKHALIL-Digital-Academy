{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Base user profile for students, parents, and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "parent", "admin"] },
        "credits": { "type": "number" },
        "linkedStudentIds": { "type": "array" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudentProfile": {
      "title": "Student Metadata",
      "description": "Additional metadata specific to students",
      "type": "object",
      "properties": {
        "level": { "type": "string" },
        "points": { "type": "number" },
        "learningPath": { "type": "array" },
        "currentModuleId": { "type": "string" }
      }
    },
    "LearningModule": {
      "title": "Learning Module",
      "description": "A module containing several lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "Lesson": {
      "title": "Lesson",
      "description": "An individual lesson within a module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      }
    },
    "Settings": {
      "title": "Global Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "maintenance": { "type": "boolean" },
        "welcomeMessage": { "type": "string" }
      }
    },
    "Stickers": {
      "title": "Sticker Book",
      "description": "Unlocked stickers for early childhood students",
      "type": "object",
      "properties": {
        "unlockedIds": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Main user collection"
    },
    "/students/{studentId}": {
      "schema": "StudentProfile",
      "description": "Student-specific metadata"
    },
    "/modules/{moduleId}": {
      "schema": "LearningModule",
      "description": "Curriculum modules"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Individual lessons"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global system settings"
    },
    "/vouchers/{code}": {
      "schema": "object",
      "description": "Credit vouchers"
    },
    "/transactions/{transactionId}": {
      "schema": "object",
      "description": "Credit transactions"
    },
    "/notifications/{notificationId}": {
      "schema": "object",
      "description": "System notifications"
    },
    "/global_chat/{chatId}": {
      "schema": "object",
      "description": "Global community chat"
    },
    "/conversations/{convId}": {
      "schema": "object",
      "description": "AI conversation logs"
    },
    "/schedules/{scheduleId}": {
      "schema": "object",
      "description": "Class schedules"
    },
    "/parentNotes/{noteId}": {
      "schema": "object",
      "description": "Notes between parents and AI/Admins"
    },
    "/user_progress/{progressId}": {
      "schema": "object",
      "description": "Individual student progress"
    },
    "/users/{userId}/earlyChildhood/stickers": {
      "schema": "Stickers",
      "description": "Early childhood stickers collection"
    }
  }
}
