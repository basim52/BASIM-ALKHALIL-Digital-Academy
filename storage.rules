rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == 'basim5252@gmail.com' || request.auth.token.admin == true);
    }
    match /videos/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg)');
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
